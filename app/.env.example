# .env.example: kontrak lingkungan Ihsan Finance. Salin ke .env lalu isi nilainya.
# Berkas .env tidak pernah di-commit (lihat .gitignore).

# ── Jaringan ────────────────────────────────────────────────────────────────
# HOST 127.0.0.1 = hanya mesin ini; pakai 0.0.0.0 di dalam wadah atau di belakang proksi.
HOST=0.0.0.0
PORT=8787
# Asal publik aplikasi. Wajib https agar cookie sesi memakai Secure dan balasan memakai HSTS.
# Kosongkan hanya untuk pengembangan lokal lewat http.
APP_ORIGIN=https://keuangan.contoh.id

# ── Basis data (SQLite berkas, PRD §13) ─────────────────────────────────────
# Direktori data wajib menunjuk volume yang tidak hilang saat wadah/deploy diganti.
IHSAN_DATA_DIR=/data
# Opsional; bawaan <IHSAN_DATA_DIR>/ihsan.db.
# IHSAN_DB_PATH=/data/ihsan.db
# Cadangan harian (NFR05). Bawaan <IHSAN_DATA_DIR>/backups dan retensi 14 snapshot.
# IHSAN_BACKUP_DIR=/data/backups
# IHSAN_BACKUP_KEEP=14

# ── Keamanan ────────────────────────────────────────────────────────────────
# 1 = percayai X-Forwarded-For/X-Forwarded-Proto dari proksi (benar di Fly/Render/Caddy).
IHSAN_TRUST_PROXY=1
# 0 = tutup pendaftaran akun baru; akun pertama tetap boleh lahir untuk bootstrap. Setelah Anda
# mendaftar di server produksi, ubah ke 0 lalu jalankan ulang.
IHSAN_ALLOW_REGISTRATION=0
SESSION_DAYS=30

# ── Operasional ─────────────────────────────────────────────────────────────
NODE_ENV=production
# debug | info | warn | error. Log tidak pernah memuat nominal, catatan, atau nama pihak (NFR08).
LOG_LEVEL=warn
