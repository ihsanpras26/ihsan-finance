#!/bin/sh
# Ihsan Finance pre-commit gate (AGENTS.md): typecheck + full test suite.
# Source of truth: docs/DECISIONS.md and PRD. Do not weaken this gate silently.
set -e

if ! command -v pnpm >/dev/null 2>&1; then
  echo "[pre-commit] pnpm not found on PATH." >&2
  echo "[pre-commit] Install pnpm, or bypass once with: git commit --no-verify" >&2
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Machines with ~8 GB need a capped old-space heap or Node aborts with "Zone Allocation failed"
# (recorded in docs/STATUS.md). 1536 MB passes the whole gate (104 server + 5 web tests + vite
# build) in about 65 s; 2560 MB aborts in the web typecheck once free memory drops under ~1.5 GB.
# An explicit NODE_OPTIONS from the caller always wins.
echo "[pre-commit] pnpm --dir app verify"
NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=1536}" pnpm --dir app verify
