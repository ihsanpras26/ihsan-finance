# .env.example: kontrak lingkungan Ihsan Finance. Salin ke .env lalu isi nilainya.
# Berkas .env tidak pernah di-commit (lihat .gitignore).

# ── Jaringan ────────────────────────────────────────────────────────────────
# HOST 127.0.0.1 = hanya mesin ini; pakai 0.0.0.0 di dalam wadah atau di belakang proksi.
HOST=0.0.0.0
PORT=8787
# Asal publik aplikasi. Wajib https agar cookie sesi memakai Secure dan balasan memakai HSTS.
# Kosongkan hanya untuk pengembangan lokal lewat http.
APP_ORIGIN=https://keuangan.contoh.id

# ── Basis data (PRD §13) ────────────────────────────────────────────────────
# Dua mode, satu skema: berkas SQLite lokal (dev/self-host) atau Turso (produksi serverless).
# Mode berkas: IHSAN_DATA_DIR wajib menunjuk volume yang tidak hilang saat wadah diganti.
IHSAN_DATA_DIR=/data
# Opsional; bawaan <IHSAN_DATA_DIR>/ihsan.db.
# IHSAN_DB_PATH=/data/ihsan.db
#
# Mode remote (Turso): setel IHSAN_DB_URL dan IHSAN_DB_TOKEN. Bila keduanya diisi, keduanya
# mengalahkan IHSAN_DATA_DIR/IHSAN_DB_PATH.
# IHSAN_DB_URL=libsql://ihsan-<akun>.turso.io
# IHSAN_DB_TOKEN=eyJhbGciOi...
#
# Cadangan harian (NFR05). Bawaan <IHSAN_DATA_DIR>/backups dan retensi 14 snapshot.
# IHSAN_BACKUP_DIR=/data/backups
# IHSAN_BACKUP_KEEP=14

# Dipakai oleh `pnpm --dir app offsite`. Sumbernya IHSAN_DB_URL bila diisi, kalau tidak berkas lokal
# IHSAN_DB_PATH. Dump ditulis ke <IHSAN_DATA_DIR>/offsite agar tidak bercampur dengan snapshot
# `backup.mjs`; isi IHSAN_OFFSITE_DIR bila ingin tempat lain.
# IHSAN_S3_ENDPOINT=https://<akun>.r2.cloudflarestorage.com
# IHSAN_S3_BUCKET=ihsan-backup
# IHSAN_S3_REGION=auto
# IHSAN_S3_ACCESS_KEY_ID=...
# IHSAN_S3_SECRET_ACCESS_KEY=...
# IHSAN_S3_PREFIX=produksi
# IHSAN_OFFSITE_KEEP=30
# IHSAN_OFFSITE_DIR=/data/offsite

# ── Keamanan ────────────────────────────────────────────────────────────────
# 1 = percayai X-Forwarded-For/X-Forwarded-Proto dari proksi (benar di Fly/Render/Caddy).
IHSAN_TRUST_PROXY=1
# 0 = tutup pendaftaran akun baru; akun pertama tetap boleh lahir untuk bootstrap. Setelah Anda
# mendaftar di server produksi, ubah ke 0 lalu jalankan ulang.
IHSAN_ALLOW_REGISTRATION=0
SESSION_DAYS=30

# ── Operasional ─────────────────────────────────────────────────────────────
NODE_ENV=production
# debug | info | warn | error. Log tidak pernah memuat nominal, catatan, atau nama pihak (NFR08).
LOG_LEVEL=warn

# ── Penjadwal lewat HTTP (mode serverless, D-21) ────────────────────────────
# Vercel cron mengirim `Authorization: Bearer $CRON_SECRET`; platform lain boleh memakai
# IHSAN_CRON_TOKEN. Selama keduanya kosong, /api/v1/internal/tick menjawab 404 dan penjadwal
# tidak bisa dipicu dari luar. Penyalaan satu proses tidak memakai keduanya (timer internal).
# CRON_SECRET=ganti-dengan-nilai-acak-panjang
# IHSAN_CRON_TOKEN=
