      "html": "<div class=\"ds-prog\"><div class=\"ds-prog-head\"><span class=\"ds-prog-label\">Tagihan</span><span class=\"ds-prog-num\">425.000 / 450.000 · 94%</span></div><div class=\"ds-prog-track\" role=\"progressbar\" aria-valuenow=\"94\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"Tagihan 94 persen terpakai\"><span class=\"ds-prog-fill ds-prog-warn\"></span></div><p class=\"ds-prog-note\">Mendekati batas</p></div>",
      "css": ".ds-prog{font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif}.ds-prog-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.ds-prog-label{font-size:14.5px;font-weight:500}.ds-prog-num{font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;font-size:11.5px;font-variant-numeric:tabular-nums;color:var(--fg-muted)}.ds-prog-track{display:block;height:12px;margin-top:8px;border-radius:999px;background:var(--surface-sunken);overflow:hidden}.ds-prog-fill{display:block;height:100%;width:94%;border-radius:999px;background:var(--accent)}.ds-prog-warn{background:var(--out)}.ds-prog-note{margin:6px 0 0;font-size:11.5px;font-weight:600;color:var(--warn)}"
