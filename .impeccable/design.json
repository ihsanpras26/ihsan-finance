  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Satu aksi utama per layar; bentuk pil penuh tanpa glow.",
      "html": "<button class=\"ds-btn\" type=\"button\">Simpan transaksi</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif;font-size:14.5px;font-weight:600;cursor:pointer;transition:background 150ms ease-out,color 150ms ease-out,transform 150ms ease-out;padding:0 20px;border:0;border-radius:999px;background:var(--accent-solid);color:var(--accent-fg)}.ds-btn:hover{background:color-mix(in srgb,var(--accent-solid) 88%,var(--fg))}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn:active{transform:translateY(1px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Aksi kedua yang tenang: garis rambut dan latar kartu.",
      "html": "<button class=\"ds-btn-2\" type=\"button\">Alokasikan dana</button>",
      "css": ".ds-btn-2{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif;font-size:14.5px;font-weight:600;cursor:pointer;transition:background 150ms ease-out,color 150ms ease-out,transform 150ms ease-out;padding:0 16px;border:1px solid var(--hairline);border-radius:14px;background:var(--surface-raised);color:var(--fg)}.ds-btn-2:hover{border-color:color-mix(in srgb,var(--fg) 20%,var(--hairline));background:var(--surface-sunken)}.ds-btn-2:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label di atas, petunjuk di bawah; isian 16px agar iOS tidak mengezoom.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Catatan</span><input class=\"ds-input\" type=\"text\" placeholder=\"Makan siang di kantor\"><span class=\"ds-field-hint\">Opsional, ikut tersimpan bersama transaksi.</span></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif}.ds-field-label{font-size:13px;font-weight:500;color:var(--fg-muted)}.ds-input{min-height:44px;padding:0 12px;border:1px solid var(--hairline);border-radius:14px;background:var(--surface-raised);color:var(--fg);font-size:16px}.ds-input::placeholder{color:color-mix(in srgb,var(--fg-muted) 60%,transparent)}.ds-input:focus{outline:none}.ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-field-hint{font-size:13px;color:var(--fg-muted)}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pilihan pil setinggi 44px dengan aria-pressed; terpilih memakai tepi dan tint aksen.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" type=\"button\" aria-pressed=\"false\">Semua dompet</button><button class=\"ds-chip ds-chip-on\" type=\"button\" aria-pressed=\"true\">BCA</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;border:1px solid var(--hairline);border-radius:999px;background:var(--surface-raised);color:var(--fg);font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif;font-size:14.5px;font-weight:500;cursor:pointer;transition:background 150ms ease-out,border-color 150ms ease-out}.ds-chip:hover{background:var(--surface-sunken)}.ds-chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-chip-on{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Unit susunan tunggal: tidak pernah bersarang di dalam kartu lain.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-head\"><h2 class=\"ds-card-title\">Anggaran September</h2><button class=\"ds-card-action\" type=\"button\">Kelola</button></header><p class=\"ds-card-body\">Makan dan minum: 492.000 dari 900.000</p></section>",
      "css": ".ds-card{padding:16px;border-radius:24px;background:var(--surface-raised);box-shadow:var(--shadow-card);color:var(--fg);font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif}.ds-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-card-title{margin:0;font-size:20px;font-weight:600;letter-spacing:-0.01em}.ds-card-action{border:0;background:transparent;color:var(--accent);font:inherit;font-size:13px;font-weight:600;cursor:pointer}.ds-card-action:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-card-body{margin:12px 0 0;font-size:14.5px;color:var(--fg-muted)}"
    },
    {
      "name": "Ledger Row",
      "kind": "custom",
      "description": "Baris daftar 60px, bentuk bersama semua daftar; nominal duduk di kolom tanda.",
      "html": "<div class=\"ds-row\"><span class=\"ds-row-icon\" aria-hidden=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><path d=\"M3 4.2c2.4-.9 4.6-.9 7 0v11.6c-2.4-.9-4.6-.9-7 0V4.2Z\"/><path d=\"M17 4.2c-2.4-.9-4.6-.9-7 0v11.6c2.4-.9 4.6-.9 7 0V4.2Z\"/><path d=\"M6 7.4h1.8M6 10h1.8M12.2 7.4H14M12.2 10H14\"/></svg></span><span class=\"ds-row-text\"><span class=\"ds-row-title\">Makan dan minum</span><span class=\"ds-row-meta\">18 Sep 2026 · BCA</span></span><span class=\"ds-money ds-money-out\"><span class=\"ds-sign\">−</span>Rp210.000</span></div>",
      "css": ".ds-row{display:flex;align-items:center;gap:12px;min-height:60px;padding:12px 0;border-bottom:1px solid var(--hairline);font-family:'Schibsted Grotesk Variable',ui-sans-serif,system-ui,sans-serif}.ds-row:last-child{border-bottom:0}.ds-row-icon{display:grid;place-items:center;width:40px;height:40px;flex:0 0 auto;border-radius:14px;background:var(--surface-sunken);color:var(--fg-muted)}.ds-row-text{display:grid;flex:1 1 auto;min-width:0;gap:2px}.ds-row-title{font-size:14.5px;font-weight:500;color:var(--fg)}.ds-row-meta{font-size:11.5px;font-weight:600;color:var(--fg-muted)}.ds-money{font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;font-size:16px;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-money .ds-sign{display:inline-block;width:1ch}.ds-money-out{color:var(--out)}.ds-money-in{color:var(--in)}.ds-money-zero{color:var(--fg)}"
    },
    {
      "name": "Money",
      "kind": "custom",
      "description": "Satu-satunya jalan menampilkan nominal: monospace, kolom tanda selalu ada dan tetap selebar 1ch meski isinya kosong saat netral.",
      "html": "<div class=\"ds-moneys\"><p class=\"ds-money ds-money-in\"><span class=\"ds-sign\">+</span>Rp1.500.000</p><p class=\"ds-money ds-money-zero\"><span class=\"ds-sign\"></span>Rp750.000</p></div>",
      "css": ".ds-moneys{display:grid;gap:6px}.ds-money{margin:0;font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace;font-size:20px;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-money .ds-sign{display:inline-block;width:1ch}.ds-money-in{color:var(--in)}.ds-money-out{color:var(--out)}.ds-money-zero{color:var(--fg)}"
    },
